# CapitalCall backend — environment
# Ledger mode: "sim" (no Canton needed) or "json" (real Canton JSON API)
CANTON_LEDGER=json
# Real Canton LocalNet (docker-compose / bootstrap.sh):
CANTON_JSON_URL=http://127.0.0.1:7575
# Party namespace + package id are DISCOVERED at runtime from the ledger
# (/v1/parties + the uploaded .dar via templateId). Override only if needed:
# CANTON_PARTY_NS=...
# CANTON_PACKAGE_ID=...
# CANTON_JWT_SECRET=secret
PORT=8080
# CAPITALCALL_DB=/data/capitalcall.db